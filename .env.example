POSTGRES_DB=ardor
POSTGRES_USER=ardor
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Login sessions are stored in Redis and remain valid for 30 days.
# Local HTTP development uses false. HTTPS deployments must set this to true.
SESSION_COOKIE_SECURE=false

# Optional: when Docker cannot resolve/reach external LLM APIs directly, point it to a host proxy.
# On Docker Desktop, a local proxy listening on 127.0.0.1:7890 is reached through host.docker.internal.
ARDOR_HTTP_PROXY_HOST=
ARDOR_HTTP_PROXY_PORT=0

# Required. Generate a unique 32-byte Base64 key; never reuse the example from old releases.
ARDOR_ENCRYPTION_KEY=

# Disabled by default to prevent SSRF. Enable only for a trusted single-user setup that must call Ollama or another LAN endpoint.
ARDOR_ALLOW_PRIVATE_API_BASE_URLS=false

# Upstream DNS for the backend container. Docker's embedded resolver forwards to the
# host's configured DNS, which on some Windows/Docker Desktop setups answers nothing —
# every outbound LLM call then fails at name resolution with
# "Base URL 的主机暂时无法解析" before a request is sent. These defaults work around that.
#
# Override them if the host resolves names the public resolvers cannot: a corporate VPN
# with split-horizon DNS, or a self-hosted model reachable only through an internal
# hostname (the usual reason to set ARDOR_ALLOW_PRIVATE_API_BASE_URLS=true). Point these
# at your internal resolvers in that case — otherwise resolution fails with the very
# same error this setting exists to fix.
ARDOR_DNS_PRIMARY=223.5.5.5
ARDOR_DNS_SECONDARY=119.29.29.29
