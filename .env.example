POSTGRES_DB=ardor
POSTGRES_USER=ardor
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Login sessions are stored in Redis and remain valid for 30 days.
# Local HTTP development uses false. HTTPS deployments must set this to true.
SESSION_COOKIE_SECURE=false

# Comma-separated existing account emails promoted to administrator at startup.
# Administrators can manage shared API defaults, user roles/status and system metrics.
ARDOR_ADMIN_EMAILS=

# Public-trial admission. Empty keeps open registration for local use. When set, only
# these comma-separated emails may create a new account; existing accounts still log in.
# Example: ARDOR_REGISTRATION_ALLOWLIST=tester1@example.com,tester2@example.com
ARDOR_REGISTRATION_ALLOWLIST=

# Comma-separated browser origins allowed to open the voice WebSocket. Keep loopback
# origins for local use and add the public HTTPS origin when using the tunnel overlay.
ARDOR_REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare Tunnel overlay only. Use absolute paths to files stored outside this
# repository; the credentials JSON and the resolved config must never be committed.
# See docs/CLOUDFLARE_TUNNEL.md.
CLOUDFLARE_TUNNEL_CONFIG=
CLOUDFLARE_TUNNEL_CREDENTIALS=

# Optional: when Docker cannot resolve/reach external LLM APIs directly, point it to a host proxy.
# On Docker Desktop, a local proxy listening on 127.0.0.1:7890 is reached through host.docker.internal.
ARDOR_HTTP_PROXY_HOST=
ARDOR_HTTP_PROXY_PORT=0

# Required. Generate a unique 32-byte Base64 key; never reuse the example from old releases.
ARDOR_ENCRYPTION_KEY=

# Disabled by default to prevent SSRF. Enable only for a trusted single-user setup that must call Ollama or another LAN endpoint.
ARDOR_ALLOW_PRIVATE_API_BASE_URLS=false

# Upstream DNS for the backend container. Docker's embedded resolver forwards to the
# host's configured DNS, which on some Windows/Docker Desktop setups answers nothing —
# every outbound LLM call then fails at name resolution with
# "Base URL 的主机暂时无法解析" before a request is sent. These defaults work around that.
#
# Override them if the host resolves names the public resolvers cannot: a corporate VPN
# with split-horizon DNS, or a self-hosted model reachable only through an internal
# hostname (the usual reason to set ARDOR_ALLOW_PRIVATE_API_BASE_URLS=true). Point these
# at your internal resolvers in that case — otherwise resolution fails with the very
# same error this setting exists to fix.
ARDOR_DNS_PRIMARY=223.5.5.5
ARDOR_DNS_SECONDARY=119.29.29.29

# OpenTelemetry technical tracing. Off by default: the PostgreSQL product trace and all
# business state work without a collector. When enabled, spans are exported to the OTLP
# HTTP endpoint below (for example the local Jaeger profile in docker-compose.observability.yml).
ARDOR_OTEL_ENABLED=false
ARDOR_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
ARDOR_OTEL_SAMPLE_RATE=1.0
ARDOR_OTEL_DEPLOYMENT_ENV=local
ARDOR_OTEL_TIMEOUT=10s
ARDOR_OTEL_CONNECT_TIMEOUT=5s
ARDOR_OTEL_MAX_BATCH_SIZE=512
ARDOR_OTEL_MAX_QUEUE_SIZE=2048
ARDOR_OTEL_SCHEDULE_DELAY=5s
ARDOR_OTEL_BATCH_TIMEOUT=30s
