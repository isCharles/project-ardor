POSTGRES_DB=ardor
POSTGRES_USER=ardor
POSTGRES_PASSWORD=ardor_local_password
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Login sessions are stored in Redis and remain valid for 30 days.

# Optional: when Docker cannot resolve/reach external LLM APIs directly, point it to a host proxy.
# On Docker Desktop, a local proxy listening on 127.0.0.1:7890 is reached through host.docker.internal.
ARDOR_HTTP_PROXY_HOST=
ARDOR_HTTP_PROXY_PORT=0

# Development-only example. Generate a unique 32-byte Base64 key before deployment.
ARDOR_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
